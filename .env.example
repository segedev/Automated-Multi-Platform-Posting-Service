# ==============================================================================
# Application Settings
# ==============================================================================
PLATFORM_TIMEOUT_SECONDS=15.0
PUBLIC_VERIFY_TIMEOUT_SECONDS=5.0

# ==============================================================================
# 1. Telegraph (https://telegra.ph/api)
# Generate in 1 command:
# curl -s "https://api.telegra.ph/createAccount?short_name=AutoPoster&author_name=AutoPoster"
# ==============================================================================
TELEGRAPH_ACCESS_TOKEN=your_telegraph_access_token_here

# ==============================================================================
# 2. GitHub Gist (https://docs.github.com/en/rest/gists/gists)
# GitHub -> Settings -> Developer settings -> Personal access tokens ->
# Fine-grained token with "Gists: Read and Write" permission
# ==============================================================================
GITHUB_GIST_TOKEN=ghp_your_github_personal_access_token_here

# ==============================================================================
# 3. Mastodon (https://docs.joinmastodon.org/methods/statuses/#create)
# Mastodon Instance -> Preferences -> Development -> New Application ->
# Check "write:statuses" scope -> Copy "Your access token"
# ==============================================================================
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=your_mastodon_access_token_here

# ==============================================================================
# 4. Bluesky (https://docs.bsky.app/docs/get-started)
# Bluesky -> Settings -> Privacy and security -> App Passwords -> Add App Password
# ==============================================================================
BLUESKY_PDS_URL=https://bsky.social
BLUESKY_HANDLE=yourhandle.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ==============================================================================
# 5. Dev.to / Forem (https://developers.forem.com/api/v1#tag/articles/operation/createArticle)
# Dev.to -> Settings -> Extensions -> DEV Community API Keys -> Generate API Key
# ==============================================================================
DEVTO_API_KEY=your_devto_api_key_here

# ==============================================================================
# 6. Telegram Bot API (https://core.telegram.org/bots/api#sendmessage)
# Message @BotFather -> /newbot -> Copy token.
# Add bot as Administrator to a public channel and set @channel_username below.
# ==============================================================================
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=@your_public_channel_username

# ==============================================================================
# 7. Discord Webhook (https://discord.com/developers/docs/resources/webhook#execute-webhook)
# Discord Server -> Channel Settings -> Integrations -> Webhooks -> Copy Webhook URL
# Optional: Set DISCORD_GUILD_ID (Server ID) so the adapter can construct the
# message jump link https://discord.com/channels/<guild_id>/<channel_id>/<id>
# if Discord omits guild_id from the webhook execution payload.
# ==============================================================================
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1234567890/webhook_secret_token
DISCORD_GUILD_ID=